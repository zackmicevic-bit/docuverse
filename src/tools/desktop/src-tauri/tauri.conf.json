{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocuVerse",
  "version": "1.0.0",
  "identifier": "com.docuverse.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "DocuVerse",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "A living 3D document universe",
    "longDescription": "DocuVerse — a living 3D document universe driven by orbital physics. Gravity equals relevance.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "store": true,
    "http": {
      "scope": ["https://api.gumroad.com/*"]
    }
  }
}
